# Copia este fichero como .env y cambia la contraseña:
#     cp .env.example .env
# El fichero .env NO se sube a git (está en .gitignore).

# Base de datos
DB_NAME=renfe
DB_USER=renfe
DB_PASSWORD=cambia_esta_contrasena
# Puerto del ordenador en el que se publica Postgres (cámbialo si 5432 está ocupado)
DB_HOST_PORT=5432

# Colector
# local = fichero de ejemplo incluido; api = Renfe en tiempo real
DATA_SOURCE=api
# Umbral de alerta en metros
ALERT_DISTANCE_METERS=1000
# Segundos entre consultas en modo api (mínimo efectivo: 15)
POLL_INTERVAL_SECONDS=15

# Backend y frontend
# Antigüedad máxima (s) para considerar "reciente" una posición (getDistancia y aviso del frontend)
MAX_POSITION_AGE_SECONDS=300
# Puerto de la API en el ordenador (Swagger en http://localhost:8000/docs)
API_PORT=8000
# Puerto de la web en el ordenador (http://localhost:8080)
WEB_PORT=8080
