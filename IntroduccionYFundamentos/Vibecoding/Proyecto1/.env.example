# Copia este archivo a .env y rellena los valores. .env no se sube nunca a git.
# Aquí solo van los NOMBRES de las variables, sin valores.

# --- PostgreSQL (contenedor Docker) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# --- FastAPI (backend) ---
API_HOST=
API_PORT=
# Orígenes permitidos para llamar a la API, separados por comas (la URL de React)
CORS_ORIGINS=

# --- React / Vite (frontend) ---
# Todo lo que empieza por VITE_ llega al navegador y lo ve cualquiera: nada secreto aquí.
VITE_API_URL=
